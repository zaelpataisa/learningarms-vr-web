---
import Icon from "../components/Icon.astro";
import { external_links } from "../utils/links";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="w-full flex justify-between items-center py-4 px-4 md:fixed bg-(--colors-06) shadow-2xl z-1000">
  <div class="flex justify-start items-center w-1/3">
    <img 
      src="/banner.webp" 
      alt="LearningsArms VR Logo" 
      class="h-8 w-auto object-contain" 
      loading="eager" 
    />
  </div>
  
  <div class="flex justify-end items-center w-2/3 gap-4">
    <div class="flex items-center bg-(--colors-05) border border-(--colors-07)/10 rounded-lg p-1 text-xs font-mono">
      <a href="/" class={`px-2 py-1 rounded-md transition-all ${lang === 'en' ? 'bg-(--colors-01) text-(--colors-05) font-bold' : 'text-(--colors-04) hover:text-(--colors-07)'}`}
      >
        EN
      </a>
      <a href="/es/" class={`px-2 py-1 rounded-md transition-all ${lang === 'es' ? 'bg-(--colors-01) text-(--colors-05) font-bold' : 'text-(--colors-04) hover:text-(--colors-07)'}`}
      >
        ES
      </a>
    </div>

    <a 
      href={external_links("github_project")} 
      target="_blank" 
      rel="noopener noreferrer"
      class="border border-(--colors-01) rounded-lg text-(--colors-01) hover:bg-(--colors-01) hover:text-(--colors-05) transition-colors px-3 py-2 text-xs md:text-sm font-mono flex items-center gap-2"
    >
      <Icon name="github" class="w-4 h-4" />
      GITHUB
    </a>
  </div>
</header>