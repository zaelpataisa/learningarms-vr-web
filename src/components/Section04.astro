---
import { external_links } from "../utils/links";
import Icon from "./Icon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<section class="reveal-on-scroll mt-32 pb-24 text-center px-4 bg-(--colors-06) border-t border-(--colors-07)/5 pt-24">
  <p class="text-2xl md:text-4xl font-black text-(--colors-07) mb-4">
    {t('Section04.title')}
  </p>
  
  <div class="w-1/2 h-px bg-(--colors-07)/20 mx-auto mb-10"></div>

  <div class="flex flex-col sm:flex-row justify-center gap-4">

    <a 
      href={external_links("github_project")} 
      target="_blank" 
      rel="noopener noreferrer"
      class="index_get_started_buttons"
    >
      <Icon name="download" class="w-6 h-6" />
      <div class="text-left leading-tight">
        <span class="block text-xs opacity-75">
          {t('Section04.btn.apk')}
        </span>
        <span class="block uppercase tracking-wider">APK (Release)</span>
      </div>
    </a>

    <!-- <a 
      href={external_links("sidequest_link")} 
      target="_blank" 
      rel="noopener noreferrer"
      class="index_get_started_buttons"
    >
      <Icon name="download" class="w-6 h-6" />
      <div class="text-left leading-tight">
        <span class="block text-xs opacity-75">
          SideQuest
        </span>
        <span class="block uppercase tracking-wider">
          {t('Section04.btn.website')}
        </span>
      </div>
    </a> -->

    <a 
      href={external_links("itchio_link")} 
      target="_blank" 
      rel="noopener noreferrer"
      class="index_get_started_buttons"
    >
      <Icon name="download" class="w-6 h-6" />
      <div class="text-left leading-tight">
        <span class="block text-xs opacity-75">
          Itch.io
        </span>
        <span class="block uppercase tracking-wider">
          {t('Section04.btn.website')}
        </span>
      </div>
    </a>
  </div>
</section>