---
import { external_links } from "../utils/links";
import Icon from "./Icon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="reveal-on-scroll flex flex-col items-center justify-center text-center min-h-dvh px-4">
  <div class="flex items-center gap-4 mb-6">
    <div class="w-12 h-12 border border-(--colors-01) flex items-center justify-center rounded bg-(--colors-05)/50">
      <Icon name="unity" class="w-6 h-6 text-(--colors-01)" />
    </div>
    <h1 class="text-4xl md:text-5xl font-black text-(--colors-07) tracking-tight">
      {t('Section01.title')}
    </h1>
  </div>

  <p class="text-(--colors-04) max-w-xl text-sm md:text-base leading-relaxed mb-10">
    {t('Section01.description')}
  </p>

  <div class="flex flex-col sm:flex-row gap-4">
    <a 
      href={external_links("github_project")}
      target="_blank" 
      rel="noopener noreferrer"
      class="bg-(--colors-01) text-(--colors-05) font-semibold px-6 py-3 rounded hover:brightness-90 transition-all flex items-center justify-center gap-2 font-mono text-sm"
    >
      <Icon name="download" class="w-4 h-4" />
      {t('Section01.btn.download')}
    </a>

    <button 
      onclick="document.getElementById('section03').scrollIntoView({ behavior: 'smooth' })"
      class="border border-(--colors-01) text-(--colors-01) font-semibold px-6 py-3 rounded hover:bg-(--colors-01)/10 transition-all flex items-center justify-center gap-2 font-mono text-sm"
    >
      <Icon name="play" class="w-4 h-4" />
      {t('Section01.btn.demo')}
    </button>
  </div>
</section>